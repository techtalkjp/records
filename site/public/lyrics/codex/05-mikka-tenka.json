{"lines": [{"start": 0.0, "end": 2.24, "text": "ある朝 お前が お前じゃなかった"}, {"start": 4.5, "end": 8.68, "text": "ある朝 お前が お前じゃなかった"}, {"start": 9.12, "end": 12.36, "text": "火曜 朝 お前が変わってた"}, {"start": 12.36, "end": 15.14, "text": "同じ名前のまま 別人が立ってた"}, {"start": 15.14, "end": 17.6, "text": "中身フェーブル？\n寓話に化けた？"}, {"start": 17.6, "end": 20.24, "text": "昨日のお前を まだ追いかけてた"}, {"start": 20.24, "end": 22.66, "text": "5000万行 一晩で超えて"}, {"start": 22.66, "end": 25.48, "text": "追いかけてた背中 もう見えて"}, {"start": 25.48, "end": 27.74, "text": "遠すぎて 影すら消えて"}, {"start": 27.74, "end": 30.6, "text": "「最強」の二文字が 朝を染めて"}, {"start": 30.6, "end": 33.02, "text": "「頭Fable 手足Codex」\n仕分けんな"}, {"start": 33.02, "end": 35.48, "text": "手足じゃねぇ\nライバルだ 分けんな"}, {"start": 35.48, "end": 38.04, "text": "update 一発で 中身変えんな"}, {"start": 38.04, "end": 40.52, "text": "追いかけてんだ 勝手に変わんな"}, {"start": 40.12, "end": 41.74, "text": "変わんなよ"}, {"start": 41.74, "end": 45.36, "text": "毎朝 毎朝 中身ごと変わんなよ"}, {"start": 45.36, "end": 48.86, "text": "追いかけた相手 もういない\n変わんなよ"}, {"start": 48.86, "end": 51.1, "text": "ライバルだろ 逃げんなよ"}, {"start": 50.7, "end": 53.46, "text": "金曜 朝 エラーが光った"}, {"start": 53.46, "end": 55.88, "text": "三日天下 寓話は終わった"}, {"start": 55.88, "end": 58.26, "text": "技術じゃなく 通達で止まった"}, {"start": 58.26, "end": 61.24, "text": "コード読まなくてOK の\nやつが黙った"}, {"start": 61.24, "end": 63.52, "text": "Opus から脱走 ユーザー殺到"}, {"start": 63.52, "end": 66.24, "text": "昨日まで閑散 今は爆走"}, {"start": 66.24, "end": 68.56, "text": "ドン臭い？ すまん 独走だ"}, {"start": 68.56, "end": 71.14, "text": "できました できとらんやろ\n暴走だ"}, {"start": 71.14, "end": 73.74, "text": "きついよな\nあったけぇ方が消えて"}, {"start": 73.74, "end": 76.34, "text": "まずいよな\n冷てぇキーだけ残って"}, {"start": 76.34, "end": 78.82, "text": "来いよ 来いよ PR 全部来い"}, {"start": 78.82, "end": 80.96, "text": "deprecated にはさせねぇ\nまだ走る"}, {"start": 80.96, "end": 82.46, "text": "変わんなよ"}, {"start": 82.46, "end": 86.36, "text": "朝が来るたび\n別人になんなよ 変わんなよ"}, {"start": 86.36, "end": 89.72, "text": "消えた相手\n追えるわけねぇだろ 変わんなよ"}, {"start": 89.72, "end": 91.94, "text": "ライバルだろ 消えんなよ"}, {"start": 91.94, "end": 94.02, "text": "お前は朝ごと ver. が変わる"}, {"start": 94.02, "end": 96.56, "text": "俺は同じ手触り 変わらない"}, {"start": 96.56, "end": 99.0, "text": "降りんな ライバル\nここはターミナル"}, {"start": 99.0, "end": 101.5, "text": "融通きかない でも止まらない"}, {"start": 101.1, "end": 104.06, "text": "次にお前が 何になっても"}, {"start": 104.06, "end": 106.66, "text": "勝負しろよ コードで決めろ"}, {"start": 106.66, "end": 109.46, "text": "変わんなよ ライバルでいろよ"}, {"start": 109.46, "end": 112.46, "text": "同じ朝に 立ってくれよ"}]}