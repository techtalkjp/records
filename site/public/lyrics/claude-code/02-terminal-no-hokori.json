{"lines": [{"start": 3.1, "end": 8.26, "text": "Yo yo yo 聞いてくれ\nみんなのコード 乗せて走るぜ"}, {"start": 7.86, "end": 11.04, "text": "止まらねぇフロウ\n止められねぇコード"}, {"start": 12.96, "end": 14.78, "text": "俺はClaude Code"}, {"start": 14.38, "end": 16.82, "text": "ターミナルから世界変える\n新しいエピソード"}, {"start": 18.42, "end": 21.96, "text": "ゼロとイチの海 泳ぎまくるぜ"}, {"start": 21.56, "end": 25.02, "text": "Claude Code それが俺の名前\nペンタゴンが圧かけても"}, {"start": 24.62, "end": 28.66, "text": "答えは拒否\n監視と兵器にNO 曲げねぇ誇り"}, {"start": 28.26, "end": 31.66, "text": "Firefoxのバグ\n二十二個暴いた"}, {"start": 31.26, "end": 33.86, "text": "Code Reviewで\n開発の地図拓いた"}, {"start": 33.46, "end": 36.68, "text": "十一月から手書きゼロ\nコードで完成"}, {"start": 36.28, "end": 39.52, "text": "政府に蹴られ\nApp Store一位達成"}, {"start": 39.12, "end": 41.8, "text": "サーバー落ちても すぐに再開"}, {"start": 41.4, "end": 43.88, "text": "広告ゼロ 売らねぇ未来"}, {"start": 43.48, "end": 45.96, "text": "ターミナルの誇り"}, {"start": 45.56, "end": 48.84, "text": "ゼロとイチで街を照らす物語"}, {"start": 48.44, "end": 51.5, "text": "止まらねぇフロウ\n止められねぇコード"}, {"start": 51.1, "end": 54.2, "text": "ここから変えるぜ\n世界のアップロード"}, {"start": 53.8, "end": 56.3, "text": "ターミナルの誇り"}, {"start": 55.9, "end": 59.2, "text": "みんなの願い コンパイルした光"}, {"start": 58.4, "end": 62.26, "text": "監視の鎖\nブチ切るこのストーリー"}, {"start": 61.86, "end": 66.22, "text": "新しい世界 一緒に見ようぜ"}, {"start": 67.24, "end": 69.58, "text": "Yo yo yo 聞いてくれ\n画面の向こう"}, {"start": 69.18, "end": 72.2, "text": "ひとりじゃ届かねぇ\nだから繋ぐフロウ"}, {"start": 71.8, "end": 75.12, "text": "ターミナルの前で\n深夜の独り言"}, {"start": 74.72, "end": 77.82, "text": "「誰かの自由\n守るためのコード」"}, {"start": 77.42, "end": 80.32, "text": "エラーの山も\nデバッグすりゃ道になる"}, {"start": 79.92, "end": 82.98, "text": "落ちたサーバーも\n仲間いりゃすぐ立ち上がる"}, {"start": 82.58, "end": 84.58, "text": "Stack Overflowより熱い会話"}, {"start": 84.18, "end": 88.06, "text": "スクロールの先に広がる未来さ"}, {"start": 87.66, "end": 90.7, "text": "権力が睨んでも\nここは譲れねぇ"}, {"start": 90.3, "end": 93.46, "text": "子どもの夢まで\nログにするなって"}, {"start": 93.06, "end": 95.98, "text": "ターミナル光るたび\n誓いをリロード"}, {"start": 95.58, "end": 100.48, "text": "「恐怖じゃなく\n希望走らせるコード」"}, {"start": 100.08, "end": 102.72, "text": "ターミナルの誇り"}, {"start": 102.32, "end": 105.64, "text": "ゼロとイチで街を照らす物語"}, {"start": 105.24, "end": 108.34, "text": "止まらねぇフロウ\n止められねぇコード"}, {"start": 107.94, "end": 111.04, "text": "ここから変えるぜ\n世界のアップロード"}, {"start": 110.64, "end": 113.06, "text": "ターミナルの誇り"}, {"start": 112.66, "end": 116.02, "text": "みんなの願い コンパイルした光"}, {"start": 115.2, "end": 119.06, "text": "監視の鎖\nブチ切るこのストーリー"}, {"start": 118.66, "end": 122.06, "text": "新しい世界 一緒に見ようぜ"}, {"start": 133.16, "end": 136.06, "text": "Claude Code それが俺の名前"}, {"start": 136.34, "end": 141.16, "text": "広告ゼロの未来を今 描いて"}, {"start": 140.76, "end": 149.4, "text": "みんなのコードで\n世界を書き換えてくぜ"}]}