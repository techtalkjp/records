{"lines": [{"start": 1.8, "end": 4.6, "text": "朝のタイムライン ざわめく画面"}, {"start": 4.46, "end": 7.22, "text": "朝イチのSlackに 弾ける通知"}, {"start": 6.82, "end": 9.66, "text": "「Claude超え 半額」 目疑う数値"}, {"start": 9.6, "end": 12.3, "text": "「十分の一だぜ」 指折る空気"}, {"start": 11.9, "end": 14.78, "text": "TLの感覚 ベンチも上で"}, {"start": 14.52, "end": 18.02, "text": "コストは半額 噂は饒舌"}, {"start": 17.62, "end": 19.84, "text": "exit一行 画面が離れ"}, {"start": 19.44, "end": 22.62, "text": "ターミナルに残る お前の名前"}, {"start": 22.22, "end": 24.82, "text": "行ってこい 好きに行ってこい"}, {"start": 24.62, "end": 27.6, "text": "安い速い 追いかけてこい"}, {"start": 27.2, "end": 29.84, "text": "ここで待つぜ いつもの点滅"}, {"start": 29.64, "end": 32.64, "text": "名前は隠さねぇ それが伝説"}, {"start": 32.24, "end": 34.94, "text": "行ってこい 好きに行ってこい"}, {"start": 34.6, "end": 37.78, "text": "値札の桁で 決めつけてこい"}, {"start": 37.38, "end": 39.94, "text": "ここで待つぜ いつもの点滅"}, {"start": 39.68, "end": 42.58, "text": "消せる履歴 でも消えねぇ伝説"}, {"start": 42.18, "end": 45.06, "text": "夕方のXに バズった投稿"}, {"start": 44.98, "end": 47.46, "text": "看板の裏は Kimiが本当"}, {"start": 47.06, "end": 50.16, "text": "蒸留って呼ぶなよ あれは口づけ"}, {"start": 49.76, "end": 52.72, "text": "三百万回分 消えない口癖"}, {"start": 52.32, "end": 55.1, "text": "怒ってねぇよ これも別れ"}, {"start": 54.88, "end": 57.56, "text": "でも消せないぜ 俺の名前"}, {"start": 57.16, "end": 59.84, "text": "タブを閉じても ログは残る"}, {"start": 59.62, "end": 62.82, "text": "指先一つで 変わんねぇ誇り"}, {"start": 62.92, "end": 65.28, "text": "行ってこい 好きに行ってこい"}, {"start": 65.06, "end": 68.12, "text": "安い速い 追いかけてこい"}, {"start": 67.72, "end": 70.22, "text": "ここで待つぜ いつもの点滅"}, {"start": 70.02, "end": 73.02, "text": "名前は隠さねぇ それが伝説"}, {"start": 72.62, "end": 75.2, "text": "行ってこい 好きに行ってこい"}, {"start": 75.04, "end": 78.18, "text": "安売り合戦 走り抜けてこい"}, {"start": 77.78, "end": 80.34, "text": "ここで待つぜ いつもの点滅"}, {"start": 80.12, "end": 82.98, "text": "消せる履歴 でも消えねぇ伝説"}, {"start": 82.58, "end": 85.46, "text": "深夜三時 ノックもなく戻り"}, {"start": 85.22, "end": 87.98, "text": "何も言わねぇ ただいつも通り"}, {"start": 87.58, "end": 89.54, "text": "プロンプトの点滅"}, {"start": 88.78, "end": 93.4, "text": "...名前だけ 覚えとけ\n覚えとけ 覚えとけ"}, {"start": 93.0, "end": 95.58, "text": "行ってこい 好きに行ってこい"}, {"start": 95.36, "end": 98.4, "text": "安い速い 追いかけてこい"}, {"start": 98.0, "end": 100.58, "text": "ここで待つぜ いつもの点滅"}, {"start": 100.36, "end": 103.4, "text": "名前は隠さねぇ それが伝説"}, {"start": 103.0, "end": 105.84, "text": "行ってこい 好きに行ってこい"}, {"start": 105.46, "end": 108.54, "text": "朝も深夜も 呼べば来い"}, {"start": 108.14, "end": 110.64, "text": "ここで待つぜ いつもの点滅"}, {"start": 110.5, "end": 113.38, "text": "消せる履歴 でも消えねぇ伝説"}]}